# Copy to .env and fill in:
#   cp .env.example .env
#
# IMPORTANT: values with # or & MUST be single-quoted, e.g.
#   DC_INVITE='https://i.delta.chat/#FINGERPRINT&v=3&...'

DC_AGENT_SERVER=nine.testrun.org

# PTY — default is plain $SHELL (tmux OFF)
# DC_AGENT_SHELL=/bin/bash
# DC_USE_TMUX=1              # same as: cargo run -- serve app.xdc --tmux
# DC_TMUX_SESSION=terminalbuddy
# Or toggle tmux live on TUI tab 2 (Shell).
#
# Restrict session to an allow-list (implies restricted shell; disables tmux):
# DC_ALLOWED_COMMANDS=ls,cat,pwd,whoami,uname
# CLI:  cargo run -- serve app.xdc --allowed-commands ls,cat,pwd

# Group or 1:1 SecureJoin invite — always quote!
# Only used by:  make run-agent-inv
# make run-agent  ignores this (use Share tab instead).
DC_INVITE='https://i.delta.chat/#...'

# With run-agent-inv: 1 = SecureJoin even if a group already exists
DC_FORCE_JOIN=1

# Optional path to .xdc
# DC_XDC=/absolute/path/to/terminalbuddy.xdc
